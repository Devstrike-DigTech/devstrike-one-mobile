  "weave": {
    "$description": "Band colours of the woven strip motif, in order. Used thin (2-6px) as structure, never as a fill.",
    "light": ["#141722", "#8F3A1F", "#F3EEE3", "#1D5C55", "#A07D2E", "#2A3766"],
    "dark": ["#EFE9DD", "#E2835F", "#161922", "#62B7A7", "#D8AE58", "#94A5DA"]
  },
  "contrast": {
    "$description": "Text/background pairs that must reach WCAG AA (4.5:1 normal text; 3:1 for pairs marked large). Checked in every theme by test/contrast.test.ts.",
    "normal": [
      ["ink", "paper"], ["ink", "surface"], ["ink", "surface-2"], ["ink", "surface-3"],
      ["ink-muted", "paper"], ["ink-muted", "surface"], ["ink-muted", "surface-2"],
      ["ink-faint", "surface"],
      ["kola-ink", "kola"], ["kola-ink", "kola-hover"], ["river-ink", "river"], ["river-ink", "river-hover"],
      ["kola", "paper"], ["kola", "surface"], ["kola", "kola-wash"],
      ["river", "paper"], ["river", "surface"], ["river", "river-wash"],
      ["brass-ink", "paper"], ["brass-ink", "surface"], ["brass-ink", "brass-wash"],
      ["indigo", "surface"], ["indigo", "indigo-wash"],
      ["warning", "surface"], ["warning", "warning-wash"],
      ["danger", "surface"], ["danger", "danger-wash"], ["danger-ink", "danger"]
    ],
    "large": [
      ["brass", "surface"], ["line-strong", "surface"], ["focus", "paper"], ["focus", "surface"]
    ]
  },
  "font": {
    "display": { "family": "Newsreader", "fallback": "Georgia, 'Times New Roman', serif", "weights": [400, 500, 600] },
    "ui": { "family": "Public Sans", "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif", "weights": [400, 500, 600, 700] },
