  "lineHeight": { "tight": 1.1, "snug": 1.3, "normal": 1.5, "relaxed": 1.65 },
  "radius": { "none": 0, "xs": 2, "sm": 4, "md": 6, "lg": 10, "pill": 999 },
  "space": {
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96
